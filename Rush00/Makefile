git: fclean
	@$(call random_shmol_cat, 作業を保存してるかな.., いいね、いいねえー , $(CLS), );
	@git add .; \
	git commit; \
	git push


clear:
	clear

clean:
	@rm -f $(OBJ)
	@rm -f main.bin main.hex
	@$(call random_shmol_cat, ... , All clean !!!, $(CLS), );
	

re: fclean all

.PHONY: all clean fclean re git hex flash clear


